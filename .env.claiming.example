# Server-only configuration. Copy selected values into .env.local (ignored).
# Never use NEXT_PUBLIC_ or EXPO_PUBLIC_ for Admin credentials.
SMARTAQUA_DEVICE_CLAIMING_ENABLED=false
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_DATABASE_URL=

# Local operator/server: point to the existing private file OUTSIDE this repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel server runtime: set these in private Environment Variables instead of
# uploading the JSON key file. Do not enable credentials on untrusted previews.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
