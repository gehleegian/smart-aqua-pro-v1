rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProtectedAccess() {
      return isSignedIn()
        && !exists(
          /databases/$(database)/documents/security_user_blocks/$(request.auth.uid)
        )
        && (
          request.auth.token.email_verified == true
          || (
            exists(
              /databases/$(database)/documents/authorization_user_policies/$(request.auth.uid)
            )
            && get(
              /databases/$(database)/documents/authorization_user_policies/$(request.auth.uid)
            ).data.emailVerificationRequired == false
          )
        );
    }

    function aquariumAccessOpen(aquariumId) {
      return aquariumId is string
        && !exists(
          /databases/$(database)/documents/security_aquarium_blocks/$(aquariumId)
        );
    }

    function isAdmin() {
      return hasProtectedAccess()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // ---- Sprint 3 access model (docs/access-model.md) ----------------------
    // Platform Admin: the existing Admin role, mapped to the platformAdmin
    // custom claim. Read-only here; status changes go through callables.
    function isPlatformAdmin() {
      return hasProtectedAccess()
        && (request.auth.token.platformAdmin == true || isAdmin());
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function orgActive(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active';
    }

    function hasOrgRole(orgId, roles) {
      return hasProtectedAccess()
        && orgId is string
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.role in roles
        && orgActive(orgId);
    }

    function isOrgOwner(orgId) {
      return hasOrgRole(orgId, ['owner']);
    }

    // aq is an aquarium document's data. A pre-migration aquarium (no orgId)
    // keeps the legacy single-owner rule.
    function ownerAccess(aq) {
      return (aq.get('orgId', null) == null && aq.ownerId == request.auth.uid)
        || (aq.get('orgId', null) != null && isOrgOwner(aq.orgId));
    }

    function memberAccess(aq) {
      return ownerAccess(aq)
        || (aq.get('orgId', null) != null
          && request.auth.uid in aq.get('caretakerIds', [])
          && hasOrgRole(aq.orgId, ['caretaker']));
    }

    function aquariumData(aquariumId) {
      return get(/databases/$(database)/documents/aquariums/$(aquariumId)).data;
    }

    // Owner or assigned caretaker: monitor, apply/dismiss recommendations.
    function canAccessAquarium(aquariumId) {
      return hasProtectedAccess()
        && !isAdmin()
        && aquariumId is string
        && aquariumAccessOpen(aquariumId)
        && exists(/databases/$(database)/documents/aquariums/$(aquariumId))
        && memberAccess(aquariumData(aquariumId));
    }

    // Aquarium-scoped data (readings, alerts, recommendations, maintenance,
    // reports): the owner, an assigned caretaker, or a platform admin.
    function canReadAquariumData(aquariumId) {
      return canAccessAquarium(aquariumId) || isPlatformAdmin();
    }

    function validUserProfileCreate(uid) {
      return request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'full_name',
          'name',
          'email',
          'contact_number',
          'role',
          'account_status',
          'created_at',
          'updated_at',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'full_name',
          'name',
          'email',
          'contact_number',
          'role',
          'account_status',
          'created_at',
          'updated_at',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.full_name is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.contact_number is string
        && request.resource.data.role == 'User'
        && request.resource.data.account_status in ['active', 'inactive']
        && request.resource.data.created_at is string
        && request.resource.data.updated_at is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.created_at == request.resource.data.createdAt
        && request.resource.data.updated_at == request.resource.data.updatedAt
        && request.resource.data.email == request.auth.token.email;
    }

    function supportThreadFields() {
      return [
        'ownerId',
        'ownerName',
        'ownerEmail',
        'subject',
        'status',
        'lastMessage',
        'lastMessageAt',
        'lastSenderRole',
        'userUnreadCount',
        'adminUnreadCount',
        'visibleToUser',
        'visibleToAdmin',
        'createdAt',
        'updatedAt'
      ];
    }

    function validSupportText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validSupportThreadCreate() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasProtectedAccess()
        && !isAdmin()
        && request.resource.data.keys().hasAll(supportThreadFields())
        && request.resource.data.keys().hasOnly(supportThreadFields())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == profile.name
        && request.resource.data.ownerEmail == profile.email
        && validSupportText(request.resource.data.subject, 120)
        && validSupportText(request.resource.data.lastMessage, 4000)
        && request.resource.data.status == 'open'
        && request.resource.data.lastSenderRole == 'User'
        && request.resource.data.userUnreadCount == 0
        && request.resource.data.adminUnreadCount == 1
        && request.resource.data.visibleToUser == true
        && request.resource.data.visibleToAdmin == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time;
    }

    function supportThreadIdentityUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validSupportReplyUpdate(role) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isUserReply = role == 'User'
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.lastSenderRole == 'User'
        && request.resource.data.adminUnreadCount == resource.data.adminUnreadCount + 1
        && request.resource.data.userUnreadCount == 0;
      let isAdminReply = role == 'Admin'
        && isAdmin()
        && request.resource.data.lastSenderRole == 'Admin'
        && request.resource.data.userUnreadCount == resource.data.userUnreadCount + 1
        && request.resource.data.adminUnreadCount == 0;
      return request.resource.data.keys().hasOnly(supportThreadFields())
        && supportThreadIdentityUnchanged()
        && resource.data.status == 'open'
        && request.resource.data.status == resource.data.status
        && changed.hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastSenderRole',
          'userUnreadCount',
          'adminUnreadCount',
          'updatedAt'
        ])
        && validSupportText(request.resource.data.lastMessage, 4000)
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time
        && (isUserReply || isAdminReply);
    }

    function validSupportReadUpdate(role) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return supportThreadIdentityUnchanged()
        && request.resource.data.keys().hasOnly(supportThreadFields())
        && (
          (role == 'User'
            && resource.data.ownerId == request.auth.uid
            && changed.hasOnly(['userUnreadCount'])
            && request.resource.data.userUnreadCount == 0)
          ||
          (role == 'Admin'
            && isAdmin()
            && changed.hasOnly(['adminUnreadCount'])
            && request.resource.data.adminUnreadCount == 0)
        );
    }

    function validSupportStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && supportThreadIdentityUnchanged()
        && request.resource.data.keys().hasOnly(supportThreadFields())
        && changed.hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.updatedAt == request.time;
    }

    function validSupportVisibilityUpdate(role) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return supportThreadIdentityUnchanged()
        && request.resource.data.keys().hasOnly(supportThreadFields())
        && (
          (role == 'User'
            && resource.data.ownerId == request.auth.uid
            && resource.data.get('visibleToUser', true) == true
            && changed.hasOnly(['visibleToUser'])
            && request.resource.data.visibleToUser == false)
          ||
          (role == 'Admin'
            && isAdmin()
            && resource.data.get('visibleToAdmin', true) == true
            && changed.hasOnly(['visibleToAdmin'])
            && request.resource.data.visibleToAdmin == false)
        );
    }

    function validSupportMessageCreate(threadId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let thread = getAfter(
        /databases/$(database)/documents/support_threads/$(threadId)
      ).data;
      let role = isAdmin() ? 'Admin' : 'User';
      return hasProtectedAccess()
        && thread.status == 'open'
        && (isAdmin() || thread.ownerId == request.auth.uid)
        && request.resource.data.keys().hasAll([
          'senderId',
          'senderName',
          'senderRole',
          'body',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'senderId',
          'senderName',
          'senderRole',
          'body',
          'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName == profile.name
        && request.resource.data.senderRole == role
        && validSupportText(request.resource.data.body, 4000)
        && request.resource.data.createdAt == request.time;
    }

    function validSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'full_name',
          'name',
          'contact_number',
          'updated_at',
          'updatedAt'
        ])
        && request.resource.data.full_name is string
        && request.resource.data.name is string
        && request.resource.data.contact_number is string
        && request.resource.data.updated_at is string
        && request.resource.data.updatedAt is string;
    }

    function userAquariumUpdateFields() {
      return [
        'name',
        'species',
        'minTemp',
        'maxTemp',
        'minPh',
        'maxPh',
        'minLevel',
        'minQuality',
        'minTdsPpm',
        'maxTdsPpm',
        'feeder',
        'light',
        'filter',
        'automationSettings',
        'manualStatus',
        'tankType',
        'tankSizeLiters',
        'tankSizeCategory',
        'tankLengthCm',
        'tankWidthCm',
        'tankHeightCm',
        'workingWaterVolumeLiters',
        'hasFiltrationSystem',
        'filtrationSetup',
        'filterCapacity',
        'fishCount',
        'fishWeightsG',
        'status',
        'updatedAt',
        'directorySchemaVersion'
      ];
    }

    function aquariumCreateRequiredFields() {
      return [
        'name',
        'species',
        'tankType',
        'tankLengthCm',
        'tankWidthCm',
        'tankHeightCm',
        'workingWaterVolumeLiters',
        'hasFiltrationSystem',
        'fishCount',
        'fishWeightsG',
        'minTemp',
        'maxTemp',
        'minPh',
        'maxPh',
        'minLevel',
        'minQuality',
        'temp',
        'level',
        'quality',
        'feeder',
        'light',
        'filter',
        'ownerId',
        'ownerName',
        'createdAt',
        'updatedAt',
        'directorySchemaVersion'
      ];
    }

    function userAquariumCreateFields() {
      return aquariumCreateRequiredFields().concat([
        'automationSettings',
        'manualStatus',
        'tankSizeLiters',
        'tankSizeCategory',
        'filtrationSetup',
        'filterCapacity'
      ]);
    }

    function aquariumDirectoryFields() {
      return [
        'name',
        'ownerId',
        'ownerName',
        'species',
        'bioload',
        'fishCount',
        'tankType',
        'tankSizeLiters',
        'tankLengthCm',
        'tankWidthCm',
        'tankHeightCm',
        'workingWaterVolumeLiters',
        'hasFiltrationSystem',
        'filtrationSetup',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ];
    }

    function validAutomationSettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'enabled',
          'feedingTimes',
          'lightOnTime',
          'lightOffTime',
          'filtrationStartTime',
          'filtrationRuntimeHours'
        ])
        && settings.keys().hasOnly([
          'enabled',
          'feedingTimes',
          'lightOnTime',
          'lightOffTime',
          'filtrationStartTime',
          'filtrationRuntimeHours'
        ])
        && settings.enabled is bool
        && settings.feedingTimes is list
        && settings.lightOnTime is string
        && settings.lightOffTime is string
        && settings.filtrationStartTime is string
        && settings.filtrationRuntimeHours is number;
    }

    function validManualStatus(status) {
      return status is map
        && status.keys().hasOnly(['feeder', 'light', 'filter'])
        && (!status.keys().hasAny(['feeder'])
          || status.feeder in ['Active', 'Inactive'])
        && (!status.keys().hasAny(['light'])
          || status.light in ['On', 'Off'])
        && (!status.keys().hasAny(['filter'])
          || status.filter in ['Active', 'Inactive']);
    }

    // Firestore Rules cannot iterate through an arbitrarily sized list. The
    // client validates every weight; rules enforce the canonical list shape,
    // count match, and a positive numeric first entry. A future trusted backend
    // should validate every entry if writes move behind a callable API.
    function validFishProfile(data) {
      return data.fishCount is int
        && data.fishCount > 0
        && data.fishWeightsG is list
        && data.fishWeightsG.size() == data.fishCount
        && data.fishWeightsG[0] is number
        && data.fishWeightsG[0] > 0;
    }

    function validTdsPpmRange(data) {
      return !data.keys().hasAny(['minTdsPpm', 'maxTdsPpm'])
        || (data.keys().hasAll(['minTdsPpm', 'maxTdsPpm'])
          && data.minTdsPpm is number
          && data.maxTdsPpm is number
          && data.minTdsPpm >= 0
          && data.minTdsPpm < data.maxTdsPpm
          // Reject infinity/NaN without imposing a water-quality upper limit.
          && data.maxTdsPpm - data.maxTdsPpm == 0);
    }

    function validAquariumFieldValues(changed) {
      return (!changed.hasAny(['name']) || request.resource.data.name is string)
        && (!changed.hasAny(['species'])
          || (request.resource.data.species is list
            && request.resource.data.species.size() == 1
            && request.resource.data.species[0] == 'Goldfish'))
        && (!changed.hasAny(['minTemp']) || request.resource.data.minTemp is number)
        && (!changed.hasAny(['maxTemp']) || request.resource.data.maxTemp is number)
        && (!changed.hasAny(['minPh', 'maxPh'])
          || (request.resource.data.minPh is number
            && request.resource.data.maxPh is number
            && request.resource.data.minPh >= 0
            && request.resource.data.maxPh <= 14
            && request.resource.data.minPh <= request.resource.data.maxPh))
        && (!changed.hasAny(['minLevel']) || request.resource.data.minLevel is number)
        && (!changed.hasAny(['minQuality']) || request.resource.data.minQuality is number)
        && (!changed.hasAny(['minTdsPpm', 'maxTdsPpm']) || validTdsPpmRange(request.resource.data))
        && (!changed.hasAny(['feeder'])
          || request.resource.data.feeder in ['Active', 'Inactive'])
        && (!changed.hasAny(['light'])
          || request.resource.data.light in ['On', 'Off'])
        && (!changed.hasAny(['filter'])
          || request.resource.data.filter in ['Active', 'Inactive'])
        && (!changed.hasAny(['automationSettings'])
          || validAutomationSettings(request.resource.data.automationSettings))
        && (!changed.hasAny(['manualStatus'])
          || validManualStatus(request.resource.data.manualStatus))
        && (!changed.hasAny(['tankType'])
          || request.resource.data.tankType == 'Freshwater')
        && (!changed.hasAny(['tankSizeLiters'])
          || request.resource.data.tankSizeLiters is number)
        && (!changed.hasAny(['tankSizeCategory'])
          || request.resource.data.tankSizeCategory in ['small', 'medium', 'large'])
        && (!changed.hasAny(['tankLengthCm'])
          || (request.resource.data.tankLengthCm is number
            && request.resource.data.tankLengthCm > 0))
        && (!changed.hasAny(['tankWidthCm'])
          || (request.resource.data.tankWidthCm is number
            && request.resource.data.tankWidthCm > 0))
        && (!changed.hasAny(['tankHeightCm'])
          || (request.resource.data.tankHeightCm is number
            && request.resource.data.tankHeightCm > 0))
        && (!changed.hasAny(['workingWaterVolumeLiters'])
          || (request.resource.data.workingWaterVolumeLiters is number
            && request.resource.data.workingWaterVolumeLiters > 0))
        && (!changed.hasAny(['hasFiltrationSystem'])
          || request.resource.data.hasFiltrationSystem is bool)
        && (!changed.hasAny(['filtrationSetup'])
          || (request.resource.data.filtrationSetup is string
            && request.resource.data.filtrationSetup.size() > 0))
        && (!changed.hasAny(['filterCapacity'])
          || request.resource.data.filterCapacity is string)
        && (!changed.hasAny(['fishCount', 'fishWeightsG'])
          || validFishProfile(request.resource.data))
        && (!changed.hasAny(['status']) || request.resource.data.status == 'active')
        && (!changed.hasAny(['updatedAt']) || request.resource.data.updatedAt is string)
        && (!changed.hasAny(['directorySchemaVersion'])
          || request.resource.data.directorySchemaVersion == 3);
    }

    function validAquariumCreate(allowedFields) {
      return request.resource.data.keys().hasAll(aquariumCreateRequiredFields())
        && request.resource.data.keys().hasOnly(allowedFields)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.species is list
        && request.resource.data.species.size() == 1
        && request.resource.data.species[0] == 'Goldfish'
        && request.resource.data.tankType == 'Freshwater'
        && request.resource.data.tankLengthCm is number
        && request.resource.data.tankLengthCm > 0
        && request.resource.data.tankWidthCm is number
        && request.resource.data.tankWidthCm > 0
        && request.resource.data.tankHeightCm is number
        && request.resource.data.tankHeightCm > 0
        && request.resource.data.workingWaterVolumeLiters is number
        && request.resource.data.workingWaterVolumeLiters > 0
        && request.resource.data.hasFiltrationSystem is bool
        && (!request.resource.data.keys().hasAny(['filtrationSetup'])
          || (request.resource.data.filtrationSetup is string
            && request.resource.data.filtrationSetup.size() > 0))
        && validFishProfile(request.resource.data)
        && request.resource.data.minTemp is number
        && request.resource.data.maxTemp is number
        && request.resource.data.minPh is number
        && request.resource.data.maxPh is number
        && request.resource.data.minPh >= 0
        && request.resource.data.maxPh <= 14
        && request.resource.data.minPh <= request.resource.data.maxPh
        && request.resource.data.minLevel is number
        && request.resource.data.minQuality is number
        && request.resource.data.temp == request.resource.data.minTemp
        && request.resource.data.level == 100
        && request.resource.data.quality == 100
        && request.resource.data.feeder == 'Active'
        && request.resource.data.light == 'On'
        && request.resource.data.filter == 'Active'
        && request.resource.data.ownerId is string
        && request.resource.data.ownerName is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.directorySchemaVersion == 3
        && (!request.resource.data.keys().hasAny(['automationSettings'])
          || validAutomationSettings(request.resource.data.automationSettings))
        && (!request.resource.data.keys().hasAny(['manualStatus'])
          || validManualStatus(request.resource.data.manualStatus));
    }

    function validAquariumDirectoryDocument(data) {
      return data.keys().hasAll([
          'name',
          'ownerId',
          'ownerName',
          'species',
          'updatedAt',
          'schemaVersion'
        ])
        && data.keys().hasOnly(aquariumDirectoryFields())
        && data.name is string
        && data.ownerId is string
        && data.ownerName is string
        && data.species is list
        && data.updatedAt is string
        && data.schemaVersion == 3
        && (!data.keys().hasAny(['bioload'])
          || data.bioload in ['low', 'medium', 'high'])
        && (!data.keys().hasAny(['fishCount'])
          || (data.fishCount is int && data.fishCount >= 0))
        && (!data.keys().hasAny(['tankType']) || data.tankType is string)
        && (!data.keys().hasAny(['tankSizeLiters']) || data.tankSizeLiters is number)
        && (!data.keys().hasAny(['tankLengthCm'])
          || (data.tankLengthCm is number && data.tankLengthCm > 0))
        && (!data.keys().hasAny(['tankWidthCm'])
          || (data.tankWidthCm is number && data.tankWidthCm > 0))
        && (!data.keys().hasAny(['tankHeightCm'])
          || (data.tankHeightCm is number && data.tankHeightCm > 0))
        && (!data.keys().hasAny(['workingWaterVolumeLiters'])
          || (data.workingWaterVolumeLiters is number
            && data.workingWaterVolumeLiters > 0))
        && (!data.keys().hasAny(['hasFiltrationSystem'])
          || data.hasFiltrationSystem is bool)
        && (!data.keys().hasAny(['filtrationSetup'])
          || (data.filtrationSetup is string
            && data.filtrationSetup.size() > 0))
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is string);
    }

    function aquariumDirectoryMatchesSource(aquariumId) {
      let aquariumPath = /databases/$(database)/documents/aquariums/$(aquariumId);
      let directoryPath = /databases/$(database)/documents/aquarium_directory/$(aquariumId);
      let aquarium = getAfter(aquariumPath).data;
      let directory = getAfter(directoryPath).data;
      return existsAfter(aquariumPath)
        && existsAfter(directoryPath)
        && aquarium.ownerId == directory.ownerId
        && aquarium.name == directory.name
        && aquarium.ownerName == directory.ownerName
        && aquarium.species == directory.species
        && aquarium.get('bioload', null) == directory.get('bioload', null)
        && aquarium.get('fishCount', null) == directory.get('fishCount', null)
        && aquarium.get('tankType', null) == directory.get('tankType', null)
        && aquarium.get('tankSizeLiters', null) == directory.get('tankSizeLiters', null)
        && aquarium.get('tankLengthCm', null) == directory.get('tankLengthCm', null)
        && aquarium.get('tankWidthCm', null) == directory.get('tankWidthCm', null)
        && aquarium.get('tankHeightCm', null) == directory.get('tankHeightCm', null)
        && aquarium.get('workingWaterVolumeLiters', null)
          == directory.get('workingWaterVolumeLiters', null)
        && aquarium.get('hasFiltrationSystem', null)
          == directory.get('hasFiltrationSystem', null)
        && aquarium.get('filtrationSetup', null)
          == directory.get('filtrationSetup', null);
    }

    function validUserAquariumUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return ownerAccess(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && changed.hasOnly(userAquariumUpdateFields())
        && validAquariumFieldValues(changed);
    }

    match /users/{uid} {
      allow get: if hasProtectedAccess() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && validUserProfileCreate(uid);
      allow update: if hasProtectedAccess()
        && request.auth.uid == uid
        && validSelfProfileUpdate();
      allow delete: if false;

      // Sprint 4 push notifications (docs/notifications.md): each browser's
      // FCM token, written by its own user; doc id = sha256(token)[:40].
      // Functions read them to send and delete invalid ones.
      match /fcmTokens/{tokenId} {
        allow read, delete: if hasProtectedAccess() && request.auth.uid == uid;
        allow create, update: if hasProtectedAccess()
          && request.auth.uid == uid
          && tokenId.matches('^[a-f0-9]{40}$')
          && request.resource.data.keys().hasOnly(['token', 'platform', 'userAgent', 'createdAt', 'lastSeenAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['web', 'ios-pwa', 'android', 'ios']
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 120
          && request.resource.data.createdAt is int
          && request.resource.data.lastSeenAt is int;
      }

      // One doc, `default`: minimum severity, muted tanks, device and cleaning toggles.
      match /notificationPrefs/{prefsId} {
        allow read: if hasProtectedAccess() && request.auth.uid == uid;
        allow create, update: if hasProtectedAccess()
          && request.auth.uid == uid
          && prefsId == 'default'
          && request.resource.data.keys().hasOnly(['minSeverity', 'mutedAquariumIds', 'deviceAlerts', 'cleaningReminders', 'updatedAt'])
          && request.resource.data.minSeverity in ['warning', 'critical']
          && request.resource.data.mutedAquariumIds is list
          && request.resource.data.mutedAquariumIds.size() <= 100
          && request.resource.data.deviceAlerts is bool
          && request.resource.data.cleaningReminders is bool
          && request.resource.data.updatedAt is int;
        allow delete: if false;
      }
    }

    match /aquariums/{aquariumId} {
      allow get: if isPlatformAdmin()
        || (hasProtectedAccess()
          && !isAdmin()
          && aquariumAccessOpen(aquariumId)
          && memberAccess(resource.data));

      // Collection queries cannot safely resolve an access-block document whose
      // ID comes from the collection wildcard; protected child data and direct
      // document access still require aquariumAccessOpen(). Queries must filter
      // on orgId (owner) or orgId + caretakerIds array-contains (caretaker).
      allow list: if isPlatformAdmin()
        || (hasProtectedAccess()
          && !isAdmin()
          && resource.data.orgId is string
          && memberAccess(resource.data));

      // Aquariums are created only by the claimDevice callable (Sprint 3), which
      // checks the claim code and creates the org. Gian's /api/devices/claim
      // route (main, PR #8) is kept for reference but superseded.
      allow create: if false;

      // Owner only: profile, thresholds, schedules. Caretakers cannot edit.
      allow update: if hasProtectedAccess()
        && !isAdmin()
        && aquariumAccessOpen(aquariumId)
        && validUserAquariumUpdate()
        && aquariumDirectoryMatchesSource(aquariumId);

      allow delete: if false;

      match /sensor_readings/{dateKey} {
        allow read: if canReadAquariumData(aquariumId);
        allow write: if false;

        match /readings/{timeKey} {
          allow read: if canReadAquariumData(aquariumId);
          allow write: if false;
        }
      }
    }

    match /aquarium_directory/{aquariumId} {
      allow read: if isPlatformAdmin()
        || (hasProtectedAccess()
          && aquariumAccessOpen(aquariumId)
          && resource.data.ownerId == request.auth.uid);

      // Created with its aquarium by claimDevice.
      allow create: if false;

      allow update: if hasProtectedAccess()
        && !isAdmin()
        && aquariumAccessOpen(aquariumId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validAquariumDirectoryDocument(request.resource.data)
        && aquariumDirectoryMatchesSource(aquariumId);

      allow delete: if false;
    }

    match /sensor_readings/{readingId} {
      allow read: if canReadAquariumData(resource.data.aquariumId);
      allow write: if false;
    }

    match /alert_records/{alertId} {
      allow read: if canReadAquariumData(resource.data.aquarium_id);
      allow update: if canAccessAquarium(resource.data.aquarium_id)
        && request.resource.data.aquarium_id == resource.data.aquarium_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
      allow create, delete: if false;
    }

    // Rules engine configuration (Sprint 2). Readable by any signed-in user
    // with protected access; written only by the seed script / Admin SDK.
    match /species/{speciesId} {
      allow read: if hasProtectedAccess();
      allow write: if false;
    }

    match /rules/{ruleId} {
      allow read: if hasProtectedAccess();
      allow write: if false;
    }

    // Created only by the Cloud Functions rules engine. The owner or an
    // assigned caretaker may move a pending recommendation to applied or
    // dismissed, stamping who and when; nothing else can change.
    match /recommendations/{recommendationId} {
      allow read: if canReadAquariumData(resource.data.aquariumId);
      allow update: if canAccessAquarium(resource.data.aquariumId)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['applied', 'dismissed']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt is int
        && request.resource.data.resolvedAt > request.time.toMillis() - 300000
        && request.resource.data.resolvedAt < request.time.toMillis() + 300000;
      allow create, delete: if false;
    }

    // Maintenance log (FR20): written only by the logMaintenance callable.
    match /maintenance_actions/{actionId} {
      allow read: if canReadAquariumData(resource.data.aquariumId);
      allow write: if false;
    }

    // Command log (FR19): written only by Cloud Functions from the RTDB
    // latest command / acknowledgement; the tank's members read it.
    match /command_logs/{logId} {
      allow read: if canReadAquariumData(resource.data.aquariumId);
      allow write: if false;
    }

    match /monitoring_reports/{reportId} {
      allow read: if canReadAquariumData(resource.data.aquarium_id);
      allow write: if false;
    }

    match /support_threads/{threadId} {
      allow get: if hasProtectedAccess()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if hasProtectedAccess()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if validSupportThreadCreate();
      allow update: if hasProtectedAccess()
        && (
          validSupportReplyUpdate(isAdmin() ? 'Admin' : 'User')
          || validSupportReadUpdate(isAdmin() ? 'Admin' : 'User')
          || validSupportStatusUpdate()
          || validSupportVisibilityUpdate(isAdmin() ? 'Admin' : 'User')
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if hasProtectedAccess()
          && (
            isAdmin()
            || get(
              /databases/$(database)/documents/support_threads/$(threadId)
            ).data.ownerId == request.auth.uid
          );
        allow create: if validSupportMessageCreate(threadId);
        allow update, delete: if false;
      }
    }

    // ---- Sprint 3 collections: written only by Cloud Functions -------------
    match /organizations/{orgId} {
      // Members can still read their org while it is suspended, so the app
      // can say so; everything else in the org is locked.
      allow get: if isPlatformAdmin()
        || (hasProtectedAccess() && exists(memberPath(orgId)));
      allow list: if isPlatformAdmin();
      allow write: if false;

      match /members/{memberId} {
        allow get: if isPlatformAdmin()
          || (hasProtectedAccess() && memberId == request.auth.uid)
          || isOrgOwner(orgId);
        allow list: if isPlatformAdmin() || isOrgOwner(orgId);
        allow write: if false;
      }
    }

    // "Which orgs am I in?": collection-group query on members where uid == me.
    match /{path=**}/members/{memberId} {
      allow read: if hasProtectedAccess()
        && resource.data.uid == request.auth.uid;
    }

    match /device_registry/{deviceId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Owners list their org's invites (query on orgId); never the token.
    match /invites/{inviteId} {
      allow read: if isPlatformAdmin() || isOrgOwner(resource.data.orgId);
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isPlatformAdmin() || isOrgOwner(resource.data.orgId);
      allow write: if false;
    }

    // Sprint 4 audit viewer: trusted-mutation events (role changes, account
    // revocation, ownership transfer) are visible to the platform admin only.
    match /security_audit_events/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /authorization_user_policies/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
