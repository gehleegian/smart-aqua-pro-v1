rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function ownsAquarium(aquariumId) {
      return isSignedIn()
        && aquariumId is string
        && exists(/databases/$(database)/documents/aquariums/$(aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(aquariumId)).data.ownerId
          == request.auth.uid;
    }

    function validUserProfileCreate(uid) {
      return request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'full_name',
          'name',
          'email',
          'contact_number',
          'role',
          'account_status',
          'created_at',
          'updated_at',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'full_name',
          'name',
          'email',
          'contact_number',
          'role',
          'account_status',
          'created_at',
          'updated_at',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.full_name is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.contact_number is string
        && request.resource.data.role == 'User'
        && request.resource.data.account_status in ['active', 'inactive']
        && request.resource.data.created_at is string
        && request.resource.data.updated_at is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.created_at == request.resource.data.createdAt
        && request.resource.data.updated_at == request.resource.data.updatedAt
        && request.resource.data.email == request.auth.token.email;
    }

    function validSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'full_name',
          'name',
          'contact_number',
          'updated_at',
          'updatedAt'
        ])
        && request.resource.data.full_name is string
        && request.resource.data.name is string
        && request.resource.data.contact_number is string
        && request.resource.data.updated_at is string
        && request.resource.data.updatedAt is string;
    }

    function validAdminRoleUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return uid != request.auth.uid
        && changed.hasOnly(['role'])
        && request.resource.data.role in ['Admin', 'User'];
    }

    function userAquariumUpdateFields() {
      return [
        'name',
        'species',
        'bioload',
        'minTemp',
        'maxTemp',
        'minLevel',
        'minQuality',
        'feeder',
        'light',
        'filter',
        'automationSettings',
        'manualStatus'
      ];
    }

    function adminAquariumUpdateFields() {
      return userAquariumUpdateFields().concat([
        'ownerId',
        'ownerName',
        'tankType',
        'tankSizeLiters',
        'tankSizeCategory',
        'tankLengthCm',
        'tankWidthCm',
        'tankHeightCm',
        'workingWaterVolumeLiters',
        'filtrationSetup',
        'filterCapacity',
        'fishCount'
      ]);
    }

    function aquariumCreateRequiredFields() {
      return [
        'name',
        'species',
        'bioload',
        'minTemp',
        'maxTemp',
        'minLevel',
        'minQuality',
        'temp',
        'level',
        'quality',
        'feeder',
        'light',
        'filter',
        'ownerId',
        'ownerName'
      ];
    }

    function userAquariumCreateFields() {
      return aquariumCreateRequiredFields().concat([
        'automationSettings',
        'manualStatus'
      ]);
    }

    function adminAquariumCreateFields() {
      return userAquariumCreateFields().concat([
        'tankType',
        'tankSizeLiters',
        'tankSizeCategory',
        'tankLengthCm',
        'tankWidthCm',
        'tankHeightCm',
        'workingWaterVolumeLiters',
        'filtrationSetup',
        'filterCapacity',
        'fishCount'
      ]);
    }

    function validAutomationSettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'enabled',
          'feedingTimes',
          'lightOnTime',
          'lightOffTime',
          'filtrationStartTime',
          'filtrationRuntimeHours'
        ])
        && settings.keys().hasOnly([
          'enabled',
          'feedingTimes',
          'lightOnTime',
          'lightOffTime',
          'filtrationStartTime',
          'filtrationRuntimeHours'
        ])
        && settings.enabled is bool
        && settings.feedingTimes is list
        && settings.lightOnTime is string
        && settings.lightOffTime is string
        && settings.filtrationStartTime is string
        && settings.filtrationRuntimeHours is number;
    }

    function validManualStatus(status) {
      return status is map
        && status.keys().hasOnly(['feeder', 'light', 'filter'])
        && (!status.keys().hasAny(['feeder'])
          || status.feeder in ['Active', 'Inactive'])
        && (!status.keys().hasAny(['light'])
          || status.light in ['On', 'Off'])
        && (!status.keys().hasAny(['filter'])
          || status.filter in ['Active', 'Inactive']);
    }

    function validAquariumFieldValues(changed) {
      return (!changed.hasAny(['name']) || request.resource.data.name is string)
        && (!changed.hasAny(['species']) || request.resource.data.species is list)
        && (!changed.hasAny(['bioload'])
          || request.resource.data.bioload in ['low', 'medium', 'high'])
        && (!changed.hasAny(['minTemp']) || request.resource.data.minTemp is number)
        && (!changed.hasAny(['maxTemp']) || request.resource.data.maxTemp is number)
        && (!changed.hasAny(['minLevel']) || request.resource.data.minLevel is number)
        && (!changed.hasAny(['minQuality']) || request.resource.data.minQuality is number)
        && (!changed.hasAny(['feeder'])
          || request.resource.data.feeder in ['Active', 'Inactive'])
        && (!changed.hasAny(['light'])
          || request.resource.data.light in ['On', 'Off'])
        && (!changed.hasAny(['filter'])
          || request.resource.data.filter in ['Active', 'Inactive'])
        && (!changed.hasAny(['automationSettings'])
          || validAutomationSettings(request.resource.data.automationSettings))
        && (!changed.hasAny(['manualStatus'])
          || validManualStatus(request.resource.data.manualStatus));
    }

    function validAquariumCreate(allowedFields) {
      return request.resource.data.keys().hasAll(aquariumCreateRequiredFields())
        && request.resource.data.keys().hasOnly(allowedFields)
        && request.resource.data.name is string
        && request.resource.data.species is list
        && request.resource.data.bioload in ['low', 'medium', 'high']
        && request.resource.data.minTemp is number
        && request.resource.data.maxTemp is number
        && request.resource.data.minLevel is number
        && request.resource.data.minQuality is number
        && request.resource.data.temp == request.resource.data.minTemp
        && request.resource.data.level == 100
        && request.resource.data.quality == 100
        && request.resource.data.feeder == 'Active'
        && request.resource.data.light == 'On'
        && request.resource.data.filter == 'Active'
        && request.resource.data.ownerId is string
        && request.resource.data.ownerName is string
        && (!request.resource.data.keys().hasAny(['automationSettings'])
          || validAutomationSettings(request.resource.data.automationSettings))
        && (!request.resource.data.keys().hasAny(['manualStatus'])
          || validManualStatus(request.resource.data.manualStatus));
    }

    function validUserAquariumUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && changed.hasOnly(userAquariumUpdateFields())
        && validAquariumFieldValues(changed);
    }

    function validAdminAquariumUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(adminAquariumUpdateFields())
        && validAquariumFieldValues(changed)
        && (!changed.hasAny(['ownerId'])
          || (request.resource.data.ownerId is string
            && exists(/databases/$(database)/documents/users/$(request.resource.data.ownerId))))
        && (!changed.hasAny(['ownerName'])
          || request.resource.data.ownerName is string);
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && validUserProfileCreate(uid);
      allow update: if isSignedIn()
        && ((request.auth.uid == uid && validSelfProfileUpdate())
          || (isAdmin() && validAdminRoleUpdate(uid)));
      allow delete: if isAdmin()
        && uid != request.auth.uid
        && resource.data.role != 'Admin';
    }

    match /aquariums/{aquariumId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && ((isAdmin()
            && validAquariumCreate(adminAquariumCreateFields())
            && exists(/databases/$(database)/documents/users/$(request.resource.data.ownerId)))
          || (request.resource.data.ownerId == request.auth.uid
            && validAquariumCreate(userAquariumCreateFields())));

      allow update: if isSignedIn()
        && ((isAdmin() && validAdminAquariumUpdate())
          || validUserAquariumUpdate());

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      match /sensor_readings/{dateKey} {
        allow read: if isAdmin() || ownsAquarium(aquariumId);
        allow write: if false;

        match /readings/{timeKey} {
          allow read: if isAdmin() || ownsAquarium(aquariumId);
          allow write: if false;
        }
      }
    }

    match /sensor_readings/{readingId} {
      allow read: if isAdmin() || ownsAquarium(resource.data.aquariumId);
      allow write: if false;
    }

    match /alert_records/{alertId} {
      allow read: if isAdmin() || ownsAquarium(resource.data.aquarium_id);
      allow update: if (isAdmin() || ownsAquarium(resource.data.aquarium_id))
        && request.resource.data.aquarium_id == resource.data.aquarium_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
      allow create, delete: if false;
    }

    match /monitoring_reports/{reportId} {
      allow read: if isAdmin() || ownsAquarium(resource.data.aquarium_id);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
